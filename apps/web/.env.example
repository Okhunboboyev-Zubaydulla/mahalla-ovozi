# Optional origin prefix for API calls. Empty = same-origin relative /api/v1 paths.
VITE_API_BASE_URL=

# Deployment label for diagnostics; defaults to Vite's MODE.
VITE_APP_ENV=development

# Dev-proxy target for /api (vite.config.ts). Defaults to http://127.0.0.1:3000.
VITE_BACKEND_URL=http://127.0.0.1:3000

# Origin header sent by the dev proxy. Defaults to http://localhost:5173.
VITE_DEV_ORIGIN=http://localhost:5173
