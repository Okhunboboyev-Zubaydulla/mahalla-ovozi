{
  "name": "mahalla-ovozi-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:web": "eslint apps/web/src apps/web/tests apps/web/vite.config.ts packages/api-contracts/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @mahalla-ovozi/web test:e2e",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @mahalla-ovozi/backend db:migrate",
    "reconcile-restore": "pnpm --filter @mahalla-ovozi/backend reconcile-restore",
    "preview:web": "pnpm --filter @mahalla-ovozi/web preview",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "vps:status": "ssh airnet-vps \"cd /opt/mahalla-ovozi && docker compose -f deploy/compose/docker-compose.prod.yml ps\"",
    "vps:logs": "ssh airnet-vps \"cd /opt/mahalla-ovozi && docker compose -f deploy/compose/docker-compose.prod.yml logs --tail=100\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
